# OpenAI API key — used server-side only by lib/ai.ts (app/api/ai/route.ts)
# Get one at https://platform.openai.com/api-keys


# Gemini API key — used server-side only by lib/ai.ts (app/api/ai/route.ts)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# OpenWeather API key — used server-side only by lib/weather.ts (app/api/weather/route.ts)
# Get one at https://openweathermap.org/api (the free tier covers current weather + geocoding;
# the One Call 3.0 endpoint used for forecasts/alerts requires enabling it on your OpenWeather account)
WEATHER_API_KEY="your-openweather-api-key"

# PostgreSQL connection string, e.g. from Supabase, Neon, Railway, or a local Postgres instance
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Random secret used to sign NextAuth session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: point at a self-hosted/paid OSRM routing instance instead of the
# public demo server used by default in app/api/routes/route.ts.
# OSRM_BASE_URL="https://your-osrm-instance.example.com"
